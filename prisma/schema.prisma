generator client {
  // Generates the typed database client imported by src/lib/db.ts.
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// An application account. passwordHash is created by the API and must never be
/// returned to or stored by frontend code.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  notes        Note[]
  createdAt    DateTime @default(now())
}

/// A private note owned by one User. Every notes API query includes userId so a
/// signed-in user cannot read or change another user's notes.
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}
